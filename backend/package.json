    "prod":    "cross-env NODE_ENV=production node server.js"
  },
  "dependencies": {
    "@google/genai":      "^1.0.0",
    "cors":               "^2.8.5",
    "cross-env":          "^7.0.3",
    "dotenv":             "^16.4.5",
    "express":            "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet":             "^7.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}